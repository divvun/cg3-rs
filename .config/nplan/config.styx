platforms (
    {
        platform rust
        files (crates/**/*.rs crates/**/Cargo.toml Cargo.toml Cargo.lock)
        checks {
            format {
                cmd "cargo fmt --all --check"
                fix "cargo fmt --all"
            }
            lint {
                cmd "cargo clippy --workspace --all-targets -- -D warnings"
            }
            lint-profiler {
                cmd "cargo clippy --workspace --all-targets --features profiler -- -D warnings"
            }
            test {
                cmd "cargo nextest run --workspace"
            }
            test-profiler {
                cmd "cargo nextest run --workspace --features profiler"
            }
        }
    }

    // The binding is tested through Python, against the extension maturin
    // builds into python/.venv, as pip would install it.
    {
        platform python
        files (crates/cg3-python/** python/pyproject.toml python/COPYING python/cg3/** python/tests/**)
        checks {
            test {
                cmd "cd python && uv sync --quiet --no-install-project && uv run --no-sync maturin develop --uv --quiet && uv run --no-sync pytest -q"
            }
            typecheck {
                cmd "cd python && uv sync --quiet --no-install-project && uv run --no-sync mypy"
            }
        }
    }

    // The globs stop short of js/cg3/pkg and js/cg3/dist, which hold build
    // output. deno check needs no build: the root deno.json stands a
    // hand-declared module in for the generated glue.
    {
        platform "typescript"
        files (js/cg3/*.ts js/test/**/*.ts)
        checks {
            typecheck {
                cmd "cd js && deno check"
            }
        }
    }
)

quality {
    // A pyo3 extension module cannot link a Rust test binary: the interpreter
    // supplies its Python symbols. python/tests tests it, under the python
    // platform's checks, and no Rust ratio can count those tests.
    exempt-paths ("crates/cg3-python/**")
    test-footprint {
        // Ratchet: floor set just under the measured crate-scope ratio
        // (tests 3626 / src 40404 = 0.0897 at the time of writing). Raise it
        // as the test corpus grows; never lower it.
        scope crate
        languages (
            {lang rust, floor-milli 85}
        )
    }
}

commit {
    type-prefix "required"
}

adoption {
    scope "maintenance"
}
