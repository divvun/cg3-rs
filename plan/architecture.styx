// Architectural element register.
//
// A timeless register: edit in place; status via lifecycle + log + decisions,
// never a duplicate corrected record. A gone element stays at lifecycle @retired.
//
// Seeded for the error-handling idiomatisation project, so its decisions have
// real scope and `nplan decision-at-modification` can answer "what governs this
// file?". It covers the blast radius of that work, not the whole engine —
// elements are added as work reaches them rather than invented up front.
elements (
    {
        id [arch:cg3:error-model]
        name "Error model"
        kind @module
        lifecycle @active
        owns (
            [spec:cg3:req:errors.result-primary]
            [spec:cg3:req:errors.layered]
            [spec:cg3:req:errors.context]
            [spec:cg3:req:errors.exit-codes-at-cli]
            [spec:cg3:req:errors.tag-regex-diagnostic]
            [spec:cg3:req:errors.parse-result]
            [spec:cg3:req:diagnostics.span]
            [spec:cg3:req:diagnostics.errors-carried]
        )
        exposes (
            "crates/cg3/src/error.rs"
        )
        decisions ([dec:cg3:results-not-unwinding] [dec:cg3:layered-error-types])
        log (
            {at "2026-08-14T00:00:00Z", kind @established, by "[dec:cg3:results-not-unwinding]"}
        )
    }

    {
        id [arch:cg3:textual-parser]
        name "Textual grammar parser"
        kind @subsystem
        lifecycle @contested
        owns (
            [spec:cg3:req:errors.parse-reports-all]
            [spec:cg3:req:diagnostics.source-identity]
            [spec:cg3:req:diagnostics.source-retained]
            [spec:cg3:req:diagnostics.source-named]
        )
        exposes (
            "crates/cg3/src/textual_parser/**"
        )
        depends_on ([arch:cg3:error-model] [arch:cg3:tag-parsing])
        decisions ([dec:cg3:results-not-unwinding] [dec:cg3:parse-sources-carry-their-name])
        log (
            {at "2026-08-14T00:00:00Z", kind @established, by "[dec:cg3:results-not-unwinding]"}
            {at "2026-08-15T00:00:00Z", kind @modified, by "[dec:cg3:parse-sources-carry-their-name]"}
        )
    }

    {
        id [arch:cg3:tag-parsing]
        name "Shared tag parsing seam"
        kind @boundary
        lifecycle @contested
        owns (
            [spec:cg3:req:tag-regex.single-seam]
            [spec:cg3:req:tag-regex.engine]
            [spec:cg3:req:tag-regex.icu-translation]
            [spec:cg3:req:tag-regex.silent-divergence]
            [spec:cg3:req:tag-regex.source-fidelity]
        )
        exposes (
            "crates/cg3/src/parser_helpers.rs"
            "crates/cg3/src/tag_regex.rs"
        )
        depends_on ([arch:cg3:error-model])
        decisions ([dec:cg3:parse-tag-aborts-on-invalid])
        log (
            {at "2026-08-14T00:00:00Z", kind @established, by "[dec:cg3:parse-tag-aborts-on-invalid]"}
        )
    }

    {
        id [arch:cg3:diagnostics]
        name "Grammar diagnostic rendering"
        kind @module
        lifecycle @active
        owns (
            [spec:cg3:req:diagnostics.rendered]
            [spec:cg3:req:diagnostics.colour-at-tty]
        )
        exposes (
            "crates/cg3/src/diagnostics.rs"
        )
        depends_on ([arch:cg3:error-model])
        log (
            {at "2026-08-15T00:00:00Z", kind @established, by "grammar-diagnostics.render"}
        )
    }

    {
        id [arch:cg3:cli-boundary]
        name "CLI boundary"
        kind @boundary
        lifecycle @active
        owns ()
        exposes (
            "crates/cg3/src/bin/**"
            "crates/cg3/src/tools/**"
        )
        depends_on ([arch:cg3:error-model])
        decisions ([dec:cg3:results-not-unwinding])
        log (
            {at "2026-08-14T00:00:00Z", kind @established, by "[dec:cg3:results-not-unwinding]"}
        )
    }
)
